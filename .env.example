# ==============================================================================
# SECRETS & ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Author: cyber-atharv
# IMPORTANT: Copy this file to .env and replace all placeholder values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Core Settings
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication & Security Secrets
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder
ADMIN_API_KEY=your_admin_api_key_placeholder
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your_secure_random_password_placeholder

# Database & External Services
DATABASE_URL=postgresql://db_user:db_password_placeholder@localhost:5432/app_db
REDIS_URL=redis://:redis_password_placeholder@localhost:6379/0
OPENAI_API_KEY=sk-your_openai_api_key_placeholder